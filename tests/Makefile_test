CXX = g++
CXXFLAGS = -std=c++17 -Wall -I./include `sdl2-config --cflags`
# SOLUCIÓN 1: Se agrega -lSDL2_mixer al final de las banderas del enlazador
LDFLAGS = `sdl2-config --libs` -lSDL2_image -lSDL2_ttf -lSDL2_mixer

TARGET = bin/test_sandbox

# SOLUCIÓN 2: Se agrega src/gfx/ShadowAudio.cpp en la tubería de archivos fuentes
SRC = tests/test_physics_sandbox.cpp \
      src/physics/ParticlePool.cpp \
      src/physics/FluidSimulation.cpp \
      src/physics/EnergyPhysics.cpp \
      src/physics/Collision.cpp \
      src/gfx/ShadowGFX.cpp \
      src/gfx/ShadowAudio.cpp \
      src/physics/DestructionEngine.cpp \
      src/physics/ElementReaction.cpp

OBJ = $(SRC:.cpp=.o)

all: $(TARGET)

$(TARGET): $(OBJ)
	@mkdir -p bin
	$(CXX) $(OBJ) -o $(TARGET) $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f tests/*.o src/physics/*.o src/gfx/*.o $(TARGET)
